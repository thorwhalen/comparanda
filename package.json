{
  "name": "comparanda",
  "version": "0.1.0",
  "description": "A schema and a view for structured comparison: alternatives x criteria, with qualified missingness, confidence, evidence links and no default aggregation.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Thor Whalen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thorwhalen/comparanda.git"
  },
  "homepage": "https://github.com/thorwhalen/comparanda#readme",
  "bugs": "https://github.com/thorwhalen/comparanda/issues",
  "keywords": [
    "mcda",
    "decision-matrix",
    "comparison",
    "schema",
    "zodal",
    "seriation",
    "pareto"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./view": {
      "import": {
        "types": "./dist/view/index.d.ts",
        "default": "./dist/view/index.js"
      },
      "require": {
        "types": "./dist/view/index.d.cts",
        "default": "./dist/view/index.cjs"
      }
    },
    "./store": {
      "import": {
        "types": "./dist/store/index.d.ts",
        "default": "./dist/store/index.js"
      },
      "require": {
        "types": "./dist/store/index.d.cts",
        "default": "./dist/store/index.cjs"
      }
    },
    "./build": {
      "import": {
        "types": "./dist/build/index.d.ts",
        "default": "./dist/build/index.js"
      },
      "require": {
        "types": "./dist/build/index.d.cts",
        "default": "./dist/build/index.cjs"
      }
    }
  },
  "bin": {
    "comparanda": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "sideEffects": [
    "./dist/standalone/*.js",
    "./src/standalone/main.ts"
  ],
  "files": [
    "dist",
    "schema"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "emit-schema": "tsx scripts/emit-json-schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit",
    "lint:boundaries": "tsx scripts/check-boundaries.ts",
    "check": "pnpm typecheck && pnpm lint:boundaries && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build && pnpm emit-schema && pnpm lint:package",
    "lint:package": "publint --strict && attw --pack . --profile node16",
    "test:standalone": "vitest run --config vitest.standalone.config.ts"
  },
  "dependencies": {
    "@zodal/groups-core": "^0.1.0",
    "@zodal/store": "^0.2.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "playwright": "^1.40.0",
    "preact": "^10.24.0",
    "vite": "^6.0.0 || ^7.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vite-plugin-singlefile": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.0.0",
    "@vitest/browser": "^3.2.7",
    "ajv": "^8.20.0",
    "playwright": "^1.63.0",
    "preact": "^10.24.0",
    "publint": "^0.3.24",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
